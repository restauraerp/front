# Copy to .env for local work.
#
# In production this file's counterpart is /var/www/front/shared/.env on the
# deploy host - the single source of build-time configuration. The deploy
# workflow pulls it down and builds against it, so a change there needs a
# redeploy, not just a restart: Next compiles every NEXT_PUBLIC_* value into
# the client bundle as a literal string.
#
# Anything required is enforced by `npm run check:env`, which `npm run build`
# runs first. A missing variable stops the build instead of compiling to an
# empty string and quietly removing the feature that reads it.

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Multi-tenancy
# The restaurant this deployment's PUBLIC STOREFRONT belongs to (its `slug` in
# the tenants table). The storefront has no login, so this is the only thing
# identifying the restaurant on menu/booking/order requests - one deployment
# serves one restaurant's public site.
#
# /admin is unaffected: staff of any restaurant can sign in here, and the tenant
# comes from their token. This value only prefills the login form's
# "Restaurant Code" field.
NEXT_PUBLIC_TENANT_ID="bangla-bistro"

# Demo configuration
# Nothing to set here. A visitor asks for the demo with /login?demo=true, and
# the login form gets the restaurant code and credentials from the API's
# GET /api/v1/demo-config - which answers only where core-api has DEMO_MODE=true.
# It used to be NEXT_PUBLIC_IS_DEMO/_DEMO_EMAIL/_DEMO_PASSWORD here, which meant
# the demo password shipped inside the JS bundle and changing it needed a
# rebuild of this app.

# Analytics
# GTM loads wherever this is set. The demo-only 60s event fires on its own when
# the visit came in through ?demo=true.
NEXT_PUBLIC_GTM_ID=""

# Marketing site, for the demo/trial conversion banner CTAs.
NEXT_PUBLIC_WEBSITE_URL=

# Meta pixel, for the demo app's 60-second Lead. Same pixel as the website.
#
# This is the ONE place the pixel is loaded. Do not add a Meta Pixel tag to the
# GTM container as well: the container used to carry the identical base code on
# All Pages, so every page called fbq('init') twice and Meta logged "Duplicate
# Pixel ID" while double-counting PageViews in the ad account.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# What the walkthrough's closing card quotes, in BDT per month. `PLAN_PRICE`
# must match core-api config/plans.php starter price_monthly - that is the side
# that charges; this is only the copy that promises it. `LIST_PRICE` is never
# charged and is only ever shown struck through. Leave both unset and the card
# makes the offer without quoting a figure.
NEXT_PUBLIC_PLAN_PRICE_MONTHLY=790
NEXT_PUBLIC_PLAN_LIST_PRICE_MONTHLY=1490
