NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Multi-tenancy
# The restaurant this deployment's PUBLIC STOREFRONT belongs to (its `slug` in
# the tenants table). The storefront has no login, so this is the only thing
# identifying the restaurant on menu/booking/order requests - one deployment
# serves one restaurant's public site.
#
# /admin is unaffected: staff of any restaurant can sign in here, and the tenant
# comes from their token. This value only prefills the login form's
# "Restaurant Code" field.
NEXT_PUBLIC_TENANT_ID="bangla-bistro"

# Demo configuration
# Nothing to set here. A visitor asks for the demo with /login?demo=true, and
# the login form gets the restaurant code and credentials from the API's
# GET /api/v1/demo-config - which answers only where core-api has DEMO_MODE=true.
# It used to be NEXT_PUBLIC_IS_DEMO/_DEMO_EMAIL/_DEMO_PASSWORD here, which meant
# the demo password shipped inside the JS bundle and changing it needed a
# rebuild of this app.

# Analytics
# GTM loads wherever this is set. The demo-only 60s event fires on its own when
# the visit came in through ?demo=true.
NEXT_PUBLIC_GTM_ID=""
